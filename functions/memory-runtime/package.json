  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/api.ts src/cleanup-worker.ts src/erasure-worker.ts src/index-dispatcher.ts src/index-worker.ts src/flush-worker.ts src/operation-reconciler.ts src/operation-worker.ts src/reconcile.ts src/search-placement-worker.ts src/shadow-worker.ts src/usage-worker.ts --target=node --format=esm --root src --outdir=dist && cp package.json dist/package.json",
    "test": "bun test",
    "typecheck": "tsrs -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1090.0",
    "@aws-sdk/client-kms": "3.1090.0",
