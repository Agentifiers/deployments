                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
                      }
                    ]
                  }
                },
                "required": [
                  "image"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
