{
  "releaseManifestVersion": 4,
  "artifacts": [
    "agent-email-runtime",
    "agent-runtime",
    "app-domains",
    "apps-database",
    "channel-provider-runtime",
    "console",
    "document-extraction",
    "event-analytics-projector",
    "event-dispatcher",
    "identity-api",
    "identity-email-worker",
    "memory-runtime",
    "ops-alerts-notifier",
    "platform-api"
  ],
  "assets": [
    "console"
  ],
  "images": [
    {
      "name": "agent-worker",
      "platform": "linux/arm64"
    },
    {
      "name": "app-gateway",
      "platform": "linux/arm64"
    },
    {
      "name": "bifrost",
      "platform": "linux/arm64"
    },
    {
      "name": "durable-streams",
      "platform": "linux/amd64"
    },
    {
      "name": "firecrawl",
      "platform": "linux/arm64"
    },
    {
      "name": "model-gateway",
      "platform": "linux/arm64"
    },
    {
      "name": "observability-hot-plane",
      "platform": "linux/arm64"
    },
    {
      "name": "stream-gateway",
      "platform": "linux/arm64"
    },
    {
      "name": "web-tools-proxy",
      "platform": "linux/arm64"
    }
  ],
  "rootProfiles": [
    {
      "name": "platform-dev",
      "allowMissingLambdas": false,
      "images": [
        "agent-worker",
        "app-gateway",
        "bifrost",
        "durable-streams",
        "firecrawl",
        "model-gateway",
        "observability-hot-plane",
        "stream-gateway",
        "web-tools-proxy"
      ],
      "lambdaMicrovm": true
    },
    {
      "name": "platform-prod",
      "allowMissingLambdas": true,
      "images": [
        "agent-worker",
        "app-gateway",
        "bifrost",
        "durable-streams",
        "firecrawl",
        "model-gateway",
        "observability-hot-plane",
        "stream-gateway",
        "web-tools-proxy"
      ],
      "lambdaMicrovm": true
    },
    {
      "name": "platform-customer",
      "allowMissingLambdas": true,
      "images": [
        "agent-worker",
        "app-gateway",
        "bifrost",
        "durable-streams",
        "firecrawl",
        "model-gateway",
        "observability-hot-plane",
        "stream-gateway",
        "web-tools-proxy"
      ],
      "lambdaMicrovm": true,
      "terraformRoot": "infrastructure/environments/customer"
    }
  ],
  "deployStages": [
    {
      "condition": null,
      "id": "callerAccount",
      "kind": "verify"
    },
    {
      "condition": null,
      "id": "init",
      "kind": "terraform"
    },
    {
      "condition": "OpenTofu state lacks the artifact bucket's versioning resource or an artifact store output",
      "id": "apply:artifact-store",
      "kind": "terraform"
    },
    {
      "condition": null,
      "id": "publishImages",
      "kind": "publish"
    },
    {
      "condition": "the profile enables Lambda MicroVM",
      "id": "apply:lambda-microvm-prerequisites",
      "kind": "terraform"
    },
    {
      "condition": "the profile enables Lambda MicroVM",
      "id": "publishMicrovmImage",
      "kind": "publish"
    },
    {
      "condition": null,
      "id": "publishLambdaArtifacts",
      "kind": "publish"
    },
    {
      "condition": null,
      "id": "apply:model-runtime-secrets",
      "kind": "terraform"
    },
    {
      "condition": null,
      "id": "syncModelRuntime:prepare",
      "kind": "configure"
    },
    {
      "condition": null,
      "id": "reconcileOrganizationGateLanes:prepare",
      "kind": "configure"
    },
    {
      "condition": null,
      "id": "apply:deployment",
      "kind": "terraform"
    },
    {
      "condition": "the profile enables Lambda MicroVM",
      "id": "verifyMicrovm",
      "kind": "verify"
    },
    {
      "condition": "the agent_runtime_worker output is set",
      "id": "verifyWorkerRollout",
      "kind": "verify"
    },
    {
      "condition": "the model_runtime_secret_arns output is a non-empty object",
      "id": "syncModelRuntime:full",
      "kind": "configure"
    },
    {
      "condition": "the app_runtime output is set",
      "id": "bootstrapAppDatabase",
      "kind": "configure"
    },
    {
      "condition": "the platform_identity_bootstrap output is set",
      "id": "bootstrapIdentity",
      "kind": "configure"
    },
    {
      "condition": "the console_assets_bucket output is set",
      "id": "publishConsoleAssets",
      "kind": "publish"
    },
    {
      "condition": null,
      "id": "deployLambdas",
      "kind": "publish"
    },
    {
      "condition": null,
      "id": "reconcileOrganizationGateLanes:repair",
      "kind": "configure"
    },
    {
      "condition": null,
      "id": "migrateOrganizationLimits",
      "kind": "configure"
    },
    {
      "condition": "the search_placement_functions output names a function",
      "id": "activateSearchPlacements",
      "kind": "configure"
    },
    {
      "condition": "the identity domain was unpublished and platform_identity_bootstrap reports publication_ready",
      "id": "apply:identity-domain",
      "kind": "terraform"
    },
    {
      "condition": "the platform_api_endpoint output is set",
      "id": "verifyPublicSurface",
      "kind": "verify"
    },
    {
      "condition": "the console_url output is set",
      "id": "verifyConsole",
      "kind": "verify"
    },
    {
      "condition": null,
      "id": "reconcileOrganizationGateLanes:final",
      "kind": "configure"
    },
    {
      "condition": null,
      "id": "migrateGovernanceInventoryShards",
      "kind": "configure"
    },
    {
      "condition": null,
      "id": "migrateMeterEventWorkspaces",
      "kind": "configure"
    },
    {
      "condition": null,
      "id": "migrateArtifactCreationIndex",
      "kind": "configure"
    },
    {
      "condition": null,
      "id": "recordInstallation",
      "kind": "record"
    }
  ],
  "endpoints": [
    "runtime-api",
    "channel-provider-api",
    "console",
    "memory-api",
    "platform-api",
    "identity",
    "stream-gateway"
  ],
  "observerRoutes": [
    {
      "method": "GET",
      "path": "/v1/system/observer/installation"
    },
    {
      "method": "GET",
      "path": "/v1/system/observer/deployments"
    },
    {
      "method": "GET",
      "path": "/v1/system/observer/components"
    },
    {
      "method": "GET",
      "path": "/v1/system/observer/alarms"
    },
    {
      "method": "GET",
      "path": "/v1/system/observer/model-providers"
    }
  ],
  "customerRootRequiredVariables": [
    "agent_email_domain",
    "billing_alert_email",
    "deploying_role_name",
    "environment_name",
    "iam_permissions_boundary_arn",
    "model_runtime_availability_zones",
    "network_cidr_block",
    "operations",
    "platform_api_domain_name",
    "platform_identity_application_origin",
    "platform_identity_domain_name",
    "platform_identity_email_sender",
    "system_observer_role_arns"
  ],
  "schemas": {
    "target": {
