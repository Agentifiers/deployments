          "ciRunId",
          "compatibility",
          "deployer",
          "files",
          "label",
          "publishedAt",
          "releaseManifestSha256",
          "sizeBytes",
          "sourceCommit",
          "version"
        ],
        "additionalProperties": false
      },
      "definitions": {}
    },
