{
  "name": "@deployments-ai/platform-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "workspaces": [
    "apps/*",
    "apps/sandbox-microvm/browser",
    "functions/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' --if-present build",
    "brain:erasure:control": "bun scripts/brain-erasure-control.ts",
    "brain:search:control": "bun scripts/brain-search-control.ts",
    "observability:clickhouse:ami:bake": "bash scripts/bake-observability-clickhouse-ami.sh",
    "observability:clickhouse:rebuild": "bun scripts/observability-clickhouse-rebuild.ts",
    "cli": "bun packages/cli/src/bin.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run contract:check && bun run test && bun run e2e:contract && bun run infrastructure:validate",
    "console:coverage": "bun scripts/console-route-coverage.ts --check",
    "contract:check": "bun scripts/export-byoc-contract.ts --check",
    "contract:export": "bun scripts/export-byoc-contract.ts",
    "credential": "bun scripts/platform-credential.ts",
    "deployment:artifacts:build": "bun scripts/build-deployment-artifacts.ts",
    "deploy": "bun scripts/deploy-platform.ts",
    "events": "bun packages/event-analytics-operator/src/cli.ts",
    "events:mcp": "bun packages/event-analytics-operator/src/mcp-server.ts",
    "firecrawl:smoke": "bun scripts/firecrawl-local-smoke.ts",
    "e2e:contract": "bun run --cwd packages/e2e test:contract",
    "e2e:live": "bun run --cwd packages/e2e test:live",
    "e2e:public": "bun run --cwd packages/e2e test:public",
    "e2e:slack-live": "bun run --cwd packages/e2e test:slack-live",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "governance:inventory:migrate": "bun scripts/governance-inventory-migration.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "infrastructure:fmt": "tofu fmt -recursive infrastructure",
    "infrastructure:fmt:check": "tofu fmt -check -recursive infrastructure",
    "infrastructure:validate": "bun scripts/local-aws.ts artifact && bun run infrastructure:fmt:check && bun scripts/validate-infrastructure.ts",
    "local-aws:destroy": "bun scripts/local-aws.ts destroy",
    "local-aws:down": "bun scripts/local-aws.ts down",
    "local-aws:env": "bun scripts/local-aws.ts env",
    "local-aws:reset": "bun scripts/local-aws.ts reset",
    "local-aws:run": "bun scripts/local-aws.ts run --",
    "local-aws:tofu": "bun scripts/local-aws.ts tofu --",
    "local-aws:up": "bun scripts/local-aws.ts up",
    "memory:search:control": "bun scripts/memory-search-control.ts",
    "openapi:write": "bun scripts/write-public-openapi.ts",
    "packages:build": "bun run --cwd packages/sdk build && bun run --cwd packages/cli build",
    "packages:publish": "bun scripts/publish-client-packages.ts",
    "packages:verify": "bun scripts/verify-client-packages.ts",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "lint": "OXLINT_TSGOLINT_PATH=\"$(tsrslint-path)\" oxlint . --type-aware --deny-warnings --no-error-on-unmatched-pattern",
    "prepare": "bun run hooks:install",
    "sandbox:lambda-microvm:image": "bun scripts/lambda-microvm-image.ts",
    "signoff": "bun run signoff:verify && gh signoff",
    "signoff:pre-commit": "bun run signoff:verify",
    "signoff:verify": "bun run check && bun run build",
    "tailnet-relay:authorize": "bun scripts/authorize-tailnet-relay.ts",
    "test": "bun scripts/run-tests.ts",
    "test:postgres": "bun run --cwd packages/app-database test:postgres",
    "test:bifrost": "bun run --cwd apps/model-gateway test:bifrost",
    "typecheck": "tsrs -b --pretty false",
    "vendor-mcp:conformance": "bun scripts/check-vendor-mcp-conformance.ts"
  },
  "devDependencies": {
    "@agentifiers/deployments-sdk": "workspace:*",
    "@arethetypeswrong/cli": "0.18.5",
    "@aws-sdk/client-dynamodb": "3.1090.0",
    "@aws-sdk/client-ecs": "3.1090.0",
    "@aws-sdk/client-kms": "3.1090.0",
    "@aws-sdk/client-lambda-microvms": "3.1090.0",
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/client-secrets-manager": "3.1090.0",
    "@aws-sdk/client-sqs": "3.1090.0",
    "@aws-sdk/client-ssm": "3.1090.0",
    "@aws-sdk/client-sts": "3.1090.0",
    "@aws-sdk/lib-dynamodb": "3.1090.0",
    "@changesets/cli": "2.31.1",
    "@deployments-ai/agent-manifest": "workspace:*",
    "@deployments-ai/api": "workspace:*",
    "@deployments-ai/api-contract": "workspace:*",
    "@deployments-ai/app-database": "workspace:*",
    "@deployments-ai/brain-runtime": "workspace:*",
    "@deployments-ai/db": "workspace:*",
    "@deployments-ai/identity": "workspace:*",
    "@deployments-ai/mcp-client": "workspace:*",
    "@deployments-ai/memory": "workspace:*",
    "@deployments-ai/memory-runtime": "workspace:*",
    "@deployments-ai/model-gateway": "workspace:*",
    "@deployments-ai/providers": "workspace:*",
    "@deployments-ai/secret-store": "workspace:*",
    "@deployments-ai/testkit": "workspace:*",
    "@deployments-ai/web-tools": "workspace:*",
    "@maschwenk/tsrslint": "0.1.5",
    "@smithy/core": "3.29.6",
    "@types/bun": "1.4.4",
    "effect": "4.0.0-beta.92",
    "npm": "11.21.0",
    "oxfmt": "0.56.0",
    "oxlint": "1.89.0",
    "publint": "0.3.22",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2"
  },
  "overrides": {
    "human-id": "4.1.1"
  },
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "lmdb",
    "msgpackr-extract"
  ]
}
